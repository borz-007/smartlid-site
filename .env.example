# Шаблон переменных окружения сервера (Next.js на Vercel).
# Значения задаются ТОЛЬКО в Vercel → Project → Settings → Environment Variables
# (для Production и Preview). Реальные значения в репозиторий не коммитить.

# Ключ Google AI Studio (Gemini). Нужен только серверу; в мобильное приложение не попадает.
GEMINI_API_KEY=your_actual_key_here

# Необязательно: модель Gemini и запасная модель (используется при 5xx/404 основной)
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Необязательно, для отладки: 1 = в ответах с ошибкой ИИ показывать подробности от Google (ключ вырезается)
AI_DEBUG_ERRORS=

# MongoDB для отчётов сообщества. На Vercel нужна облачная база (например, MongoDB Atlas), не localhost.
MONGO_URL=
DB_NAME=

# Токен модератора: Authorization: Bearer <ADMIN_TOKEN> для /api/admin/reports. Без него модерация отключена.
ADMIN_TOKEN=

# Необязательно: соль для хеширования идентификатора устройства в отчётах
REPORT_SALT=
