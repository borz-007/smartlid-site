# Ключ Google AI Studio (https://aistudio.google.com/apikey).
# ВНИМАНИЕ: переменные EXPO_PUBLIC_* встраиваются в бандл приложения и видны любому,
# кто его распакует. Для продакшена используйте собственный прокси-сервер (см. README).
EXPO_PUBLIC_GEMINI_API_KEY=
# Модель Gemini. gemini-1.5-flash снята с обслуживания Google, поэтому по умолчанию 3.8-flash.
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.8-flash
