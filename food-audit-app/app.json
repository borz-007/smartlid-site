{
  "expo": {
    "name": "Safa: Halal & Food Scanner",
    "slug": "food-audit-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.foodaudit.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Камера нужна для сканирования штрихкодов и фотографирования состава продукта.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "CFBundleDisplayName": "Safa"
      }
    },
    "android": {
      "package": "com.foodaudit.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна для сканирования штрихкодов и фотографирования состава продукта."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к фото нужен, чтобы приложить снимок к отчёту о продукте.",
          "cameraPermission": "Камера нужна, чтобы сфотографировать упаковку для отчёта о продукте."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "./plugins/withAndroidAppLabel",
        "Safa"
      ],
      "expo-asset",
      "expo-font"
    ]
  }
}
