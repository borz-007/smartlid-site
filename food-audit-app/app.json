{
  "expo": {
    "name": "Food Audit",
    "slug": "food-audit-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.foodaudit.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Камера нужна для сканирования штрихкодов и фотографирования состава продукта.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "com.foodaudit.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна для сканирования штрихкодов и фотографирования состава продукта."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-asset",
      "expo-font"
    ]
  }
}
