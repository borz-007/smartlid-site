# Шаблон переменных окружения проекта SAFA API (отдельный проект Vercel, Root Directory = safa-api).
# Значения задаются ТОЛЬКО в Vercel -> проект safa-api -> Settings -> Environment Variables
# (Production и Preview). Реальные значения в репозиторий не коммитить.
# Переменные сайта slid-tech.com (проект smartlid-site) сюда НЕ копировать: проекты изолированы.

# Ключ Google AI Studio (Gemini). Нужен только этому серверу; в мобильное приложение не попадает.
GEMINI_API_KEY=your_actual_key_here

# Необязательно: модель Gemini и запасная модель (используется при 5xx/404 основной)
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Необязательно, для отладки: 1 = в ответах с ошибкой ИИ показывать подробности от Google (ключ вырезается)
AI_DEBUG_ERRORS=

# Отдельная база SAFA в MongoDB (например, Atlas) с отдельным пользователем, у которого доступ только к этой базе.
# Имя базы ОБЯЗАТЕЛЬНО содержит "safa" (например, safa): иначе сервер откажется работать, чтобы случайно не
# подключиться к базе сайта.
MONGO_URL=
DB_NAME=safa

# Токен модератора: Authorization: Bearer <ADMIN_TOKEN> для /api/admin/reports. Без него модерация отключена.
ADMIN_TOKEN=

# Необязательно: соль для хеширования идентификатора устройства в отчётах
REPORT_SALT=
