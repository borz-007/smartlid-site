# Шаблон переменных окружения. Скопируйте в .env (файл .env игнорируется git) и заполните.
# Реальные значения в репозиторий не коммитить. В CI ключ задаётся как секрет
# репозитория EXPO_PUBLIC_GEMINI_API_KEY (Settings → Secrets and variables → Actions).
#
# ВНИМАНИЕ: переменные EXPO_PUBLIC_* встраиваются в бандл приложения и могут быть
# извлечены из APK. Для продакшена используйте прокси (EXPO_PUBLIC_AI_PROXY_URL),
# а ключ в консоли Google ограничьте и поставьте лимит квоты.

# Ключ Google AI Studio (https://aistudio.google.com/apikey)
EXPO_PUBLIC_GEMINI_API_KEY=

# Необязательно: модель Gemini (если пусто — значение по умолчанию из src/constants/config.ts)
EXPO_PUBLIC_GEMINI_MODEL=

# Необязательно: запасная модель, если основная отвечает 5xx или 404
EXPO_PUBLIC_GEMINI_FALLBACK_MODEL=

# Необязательно, только для отладки: 1 = показывать в ошибках ИИ HTTP-код и сообщение Google
EXPO_PUBLIC_DEBUG_AI_ERRORS=

# Необязательно: HTTPS-адрес собственного прокси к Gemini (ключ тогда хранится на сервере)
EXPO_PUBLIC_AI_PROXY_URL=
